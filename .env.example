# Copy to .env and fill in. .env is ignored by git. Never commit real values, not even test keys.
# Section 6 of the Architecture contract explains every key.

APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# Channel IDs the bot may serve (comma-separated). Required in development and staging, so a test
# build cannot read a real channel. In production, leave it empty: the bot then serves every
# channel it has been added to. The bot must be added to each channel either way.
CHANNEL_ALLOWLIST=

# Languages as code:role. Leave empty for the default: en:team,es:team,ru:customer,ko:customer,vi:customer,zh:customer
LANGUAGE_SEED=
READ_LANGUAGE=en
# Email domains of X3M members, comma-separated. Leave empty for x3mads.com,loomit.ai
MEMBER_EMAIL_DOMAINS=
# Minimum lead of the top language over the runner-up, from 0.5 to 1. Leave empty for 0.7.
CLASSIFIER_MIN_CONFIDENCE=
CLASSIFIER_TIMEOUT=
TRANSLATOR_TIMEOUT=

# Secrets: one value per environment (development, staging, production).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_MODE=socket

TRANSLATOR_BASE_URL=
TRANSLATOR_MODEL=
TRANSLATOR_API_KEY=
TRANSLATOR_EXTRA_BODY=
